# Plantilla del .env de docker compose (docker-compose.yml). Cópiala a .env (ignorado por git) y cambia TODOS los
# valores: estos son de ejemplo, no sirven. Para generar uno al azar:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Si falta una variable obligatoria, docker compose se niega a arrancar y dice cuál.

# Las 8 bases y MinIO (contraseña de al menos 8 caracteres)
DB_USER=chakra
DB_PASSWORD=cambiar-contrasena-bases-y-minio
# Los JWT se firman con RS256: sus claves no van aquí, las genera python scripts/claves_jwt.py nueva (en .claves/jwt)
# Culqi en modo PRUEBA
CULQI_SECRET_KEY=sk_test_cambiar
# RabbitMQ (el servidor y sus clientes usan las mismas)
RABBITMQ_USER=chakra
RABBITMQ_PASSWORD=cambiar-contrasena-rabbitmq
# Primer administrador: Usuarios lo crea al arrancar si todavía no hay ninguno
ADMIN_BOOTSTRAP_PASSWORD=cambiar-contrasena-del-primer-admin
# DELETE de limpieza de datos de prueba
QA_LIMPIEZA_SECRETO=cambiar-secreto-limpieza-qa
# Una clave por cada par de servicios que se llaman entre sí (emisor_A_receptor)
PAGOS_A_PRODUCTOS_SECRETO=cambiar-secreto-pagos-a-productos
PEDIDOS_A_PRODUCTOS_SECRETO=cambiar-secreto-pedidos-a-productos
PRODUCTORES_A_PRODUCTOS_SECRETO=cambiar-secreto-productores-a-productos
PRODUCTORES_A_CERTIFICACION_SECRETO=cambiar-secreto-productores-a-certificacion
PRODUCTOS_A_CERTIFICACION_SECRETO=cambiar-secreto-productos-a-certificacion
TRANSPORTE_A_CERTIFICACION_SECRETO=cambiar-secreto-transporte-a-certificacion
TRANSPORTE_A_PAGOS_SECRETO=cambiar-secreto-transporte-a-pagos
PAGOS_A_PEDIDOS_SECRETO=cambiar-12
TRANSPORTE_A_PEDIDOS_SECRETO=cambiar-secreto-transporte-a-pedidos

# Opcionales (vacías = esa función queda apagada)
GEMINI_API_KEY=
SUNAT_RUC_TOKEN=
SMTP_HOST=
SMTP_PUERTO=
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=
VAPID_CLAVE_PUBLICA=
VAPID_CLAVE_PRIVADA=
VAPID_CONTACTO=
