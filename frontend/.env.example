# Copiar a .env.local. Ninguna de estas variables es secreta: Vite las incluye en el código que recibe el navegador.

# Base del gateway. Cada servicio cuelga de <base>/<servicio> (ver k8s/traefik-routes.yaml).
# En desarrollo, el proxy de Vite lleva /api y /media a Traefik (localhost:8000).
VITE_API_URL=/api

# Llave pública de Culqi. En local, la de pruebas (pk_test_gGgpDDFDAt5HjYwI, la misma que trae el Dockerfile); la de
# producción empieza con pk_live_.
VITE_CULQI_PUBLIC_KEY=

# Client ID de Google (OAuth 2.0, tipo "Web application"). Está atado a los orígenes autorizados de cada entorno: el
# origen desde el que se abre la aplicación (por ejemplo http://localhost:5173) tiene que estar en "Orígenes de
# JavaScript autorizados" del Client ID en Google Cloud Console. El de desarrollo (también en el Dockerfile) es
# 546858204347-n72ku2ohsq88er0p297hrd9n2rirsc86.apps.googleusercontent.com.
VITE_GOOGLE_CLIENT_ID=
